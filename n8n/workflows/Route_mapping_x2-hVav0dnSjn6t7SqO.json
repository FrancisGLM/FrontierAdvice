        "id": "da2b1476-3da6-4fe6-a75e-48effd1feaf1",
        "name": "Request Open Route API ABC Car",
        "type": "n8n-nodes-base.httpRequest",
        "position": [
          -544,
          272
        ],
        "notesInFlow": true,
        "typeVersion": 4.2
      },
      {
        "parameters": {
          "jsCode": "const inputItems = $input.all();\nconst triggerItem = $items(\"When Executed by Another Workflow\", 0, 0)[0]?.json ?? {};\n\nreturn [\n  {\n    json: {\n      paso_fronterizo_primario: triggerItem.paso_fronterizo_primario ?? \"\",\n      paso_fronterizo_alternativo: triggerItem.paso_fronterizo_alternativo ?? \"\"\n    }\n  },\n  ...inputItems.map(item => ({\n    json: {\n      ...item.json\n    }\n  }))\n];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1152,
          -32
        ],
        "id": "b68f89a7-94c7-4b4a-b012-6fedc1138685",
        "name": "Packaging"
      },
      {
        "parameters": {
          "jsCode": "return [\n  {\n    json: {\n      mensaje_natural: 'El paso fronterizo seleccionado para esta ruta es el Complejo Fronterizo Pehuenche, que se encuentra en estado operativo abierto y presenta una distancia total de 1466.6 km. Además, el tiempo estimado de viaje es de 21 horas y 33 minutos. En comparación, la segunda mejor opción es el Complejo Fronterizo Vergara, que requiere recorrer 1523.3 km y tiene un tiempo de viaje de 25 horas y 10 minutos, lo que implica un incremento de 56.7 km y aproximadamente 3 horas y 37 minutos más de viaje respecto al ganador.'\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -336,
          464
        ],
        "id": "75d45984-052e-42c0-a1d3-388e4b65fce9",
        "name": "Code in JavaScript"
      },
      {
        "parameters": {
          "jsCode": "/**\n * NODO CODE DE N8N — FrontierAdvice: Formatear respuesta de doble ruta\n */\n\nconst items = $input.all();\n\n// ── Validaciones descriptivas ──────────────────────────────────────────────\nif (!items || items.length === 0) {\n  throw new Error('[FrontierAdvice] El nodo no recibió ningún item. Verifica las conexiones del workflow.');\n}\n\nif (items.length < 3) {\n  const received = items.map((item, i) => `  Item ${i}: ${JSON.stringify(item.json).slice(0, 60)}...`).join('\\n');\n  throw new Error(\n    `[FrontierAdvice] Se esperaban exactamente 3 items (mensaje + geo1 + geo2), ` +\n    `pero se recibieron ${items.length}:\\n${received}`\n  );\n}\n\n// ── Extraer y validar cada item ────────────────────────────────────────────\nconst mensaje = items[0].json;\nconst rutaPrimaria = items[1].json;\nconst rutaAlternativa = items[2].json;\n\n// (Se eliminó la validación estricta de la llave \"error\" para permitir omitirla)\n\nif (rutaPrimaria.type !== 'FeatureCollection') {\n  throw new Error(`[FrontierAdvice] El Item 1 (ruta primaria) no es un FeatureCollection. ` +\n    `type recibido: \"${rutaPrimaria.type}\". Claves: ${Object.keys(rutaPrimaria).join(', ')}`);\n}\n\nif (rutaAlternativa.type !== 'FeatureCollection') {\n  throw new Error(`[FrontierAdvice] El Item 2 (ruta alternativa) no es un FeatureCollection. ` +\n    `type recibido: \"${rutaAlternativa.type}\". Claves: ${Object.keys(rutaAlternativa).join(', ')}`);\n}\n\n// ── Construir el payload como JSON string serializado ──────────────────────\nconst routeArray = [mensaje, rutaPrimaria, rutaAlternativa];\n\nreturn [\n  {\n    json: {\n      routeResult: JSON.stringify(routeArray)\n    }\n  }\n];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1376,
          -32
        ],
        "id": "63ef2b53-4d69-40f3-bdb6-75703bc6525a",
        "name": "Parser Corrector"
      }
    ],
