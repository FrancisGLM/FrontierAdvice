    {
      "parameters": {
        "jsCode": "\nconst config = $('Set Config').first().json;\nconst pasos = $input.first().json.data ?? [];\n\nreturn pasos.map(p => ({\n  json: {\n    paso_id: p.id,\n    paso_documentId: p.documentId,\n    nombre: p.nombre_oficial,\n    codigo_fuente: p.codigo_fuente,\n    latitud: p.latitud,\n    longitud: p.longitud,\n    strapiurl: config.strapiurl,\n    capturedat: config.capturedat,\n    openmeteo_base: config.openmeteo_base\n  }\n}));"
      },
