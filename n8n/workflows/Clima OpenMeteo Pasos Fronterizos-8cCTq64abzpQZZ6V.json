      "id": "a5eafa70-3c4e-4eac-95fc-a299eac32b46",
      "name": "Consultar Open-Meteo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -848,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst paso   = $('Loop Paso x Paso').item.json;\nconst meteo  = $input.item.json;\nconst curr   = meteo.current ?? {};\nconst daily  = meteo.daily  ?? {};\n\nconst wmoLabel = (code) => {\n  if (code === 0)              return 'Despejado';\n  if (code <= 3)               return 'Parcialmente nublado';\n  if (code <= 48)              return 'Niebla';\n  if (code <= 67)              return 'Lluvia';\n  if (code <= 77)              return 'Nieve';\n  if (code <= 82)              return 'Lluvia intensa';\n  if (code <= 99)              return 'Tormenta';\n  return 'Desconocido';\n};\n\nconst riskLevel = (code, viento) => {\n  if ([71,72,73,75,77,85,86].includes(code))  return 'Alto';\n  if ([95,96,99].includes(code))               return 'Alto';\n  if (viento > 100)                            return 'Alto';\n  if ([61,63,65,80,81,82].includes(code))      return 'Medio';\n  if (viento > 60)                             return 'Medio';\n  return 'Bajo';\n};\n\nconst days = (daily.time ?? []).slice(1, 4).map((fecha, i) => ({\n  fecha:            fecha,\n  temp_max:         daily.temperature_2m_max?.[i+1] ?? null,\n  temp_min:         daily.temperature_2m_min?.[i+1] ?? null,\n  precipitacion:    daily.precipitation_sum?.[i+1]  ?? null,\n  viento_max:       daily.wind_speed_10m_max?.[i+1] ?? null,\n  weathercode:      daily.weathercode?.[i+1]         ?? null,\n  descripcion:      wmoLabel(daily.weathercode?.[i+1] ?? 0),\n  nivel_riesgo:     riskLevel(daily.weathercode?.[i+1] ?? 0, daily.wind_speed_10m_max?.[i+1] ?? 0)\n}));\n\nconst wcode  = curr.weathercode ?? 0;\nconst viento = curr.wind_speed_10m ?? 0;\n\nreturn [{\n  json: {\n    paso_id: paso.paso_id,\n    paso_documentId: paso.paso_documentId,\n    nombre: paso.nombre,\n    codigo_fuente: paso.codigo_fuente,\n    strapiurl: paso.strapiurl,\n    capturedat: paso.capturedat,\n    temperatura_actual: curr.temperature_2m ?? null,\n    humedad_actual: curr.relative_humidity_2m ?? null,\n    viento_actual: viento,\n    precipitacion_actual: curr.precipitation ?? null,\n    weathercode: wcode,\n    descripcion_actual: wmoLabel(wcode),\n    nivel_riesgo_actual: riskLevel(wcode, viento),\n    pronostico_3dias: days\n  }\n}];\n"
      },
