        64,
        -592
      ],
      "id": "7eafd9f7-0d22-4294-a76d-b140091b06a4",
      "name": "Build Extract Request"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      source_id: $json.source_id,\n      source_type: $json.source_type,\n      source_name: $json.source_name,\n      channel_label: $json.channel_label,\n      captured_at: $json.captured_at,\n      messages: [\n        \"Complejo Los Libertadores cerrado preventivamente por nevadas y bajas temperaturas.\",\n        \"Paso Pehuenche habilitado con precaución para vehículos menores.\",\n        \"Cardenal Samoré opera con normalidad en ambos sentidos.\",\n        \"Se recomienda revisar estado meteorológico antes de viajar.\",\n        \"Horarios diferenciados para transporte de carga en algunos complejos.\"\n      ]\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        -752
      ],
      "id": "9dc5e8a5-9d9d-49fd-a85f-0da3e32d7267",
      "name": "Mock WhatsApp Messages"
    },
    {
      "parameters": {
        "jsCode": "const raw =\n  $json.text ??\n  $json.output ??\n  $json.response ??\n  $json.result ??\n  $json.message ??\n  $json.content ??\n  $json;\n\nlet parsed;\nlet cleaned = raw;\n\nif (typeof cleaned === \"string\") {\n  cleaned = cleaned.replace(/```json\\s*/g, \"\").replace(/```/g, \"\").trim();\n\n  const start = cleaned.indexOf(\"{\");\n  const end = cleaned.lastIndexOf(\"}\");\n  if (start !== -1 && end !== -1) {\n    cleaned = cleaned.slice(start, end + 1);\n  }\n\n  parsed = JSON.parse(cleaned);\n} else {\n  parsed = cleaned;\n}\n\nif (!parsed || !parsed.items || !Array.isArray(parsed.items)) {\n  throw new Error(\"No se encontró items[] en la salida del modelo. Output recibido: \" + JSON.stringify($json).slice(0, 1000));\n}\n\nreturn parsed.items.map(item => ({\n  json: {\n    codigo_fuente: item.codigo_fuente || null,\n    fecha_reporte: item.fecha_reporte || $(\"Set Source Metadata\").first().json.captured_at,\n    estado_general: item.estado_general || \"desconocido\",\n    fuente: item.fuente || \"whatsapp_upf\",\n    mensaje_original: item.mensaje_original || null,\n    confianza_extraccion: item.confianza_extraccion ?? 0.5,\n    origen_tipo: item.origen_tipo || \"whatsapp_channel\"\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        -592
      ],
      "id": "27f936f5-18cf-4667-9cf5-55b85cd21cd6",
