    {
      "parameters": {
        "jsCode": "const pasoResp = $json.data || [];\nif (!pasoResp.length) {\n  throw new Error(\"No se encontró PasoFronterizo para codigo_fuente\");\n}\n\nconst paso = pasoResp[0];\n\nconst original = $(\"Parse Model Output\").item.json;\n\nreturn [\n  {\n    json: {\n      data: {\n        fecha_reporte: original.fecha_reporte,\n        estado_general: original.estado_general,\n        fuente: original.fuente,\n        mensaje_original: original.mensaje_original,\n        confianza_extraccion: String(original.confianza_extraccion),\n        origen_tipo: original.origen_tipo,\n        id_paso: paso.id\n      }\n    }\n  }\n];"
