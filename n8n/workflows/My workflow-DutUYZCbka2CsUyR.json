        "jsCode": "const paso  = $('Buscar PasoFronterizo').item.json.data[0];\nconst d     = $('Parse Output Gemini').item.json;\nconst msgM  = $('Filtrar y Splitear Mensajes').item.json;\n\nreturn [{ json: {\n  payload: {\n    data: {\n      fecha_reporte:        d.msg_fecha_iso,\n      estado_general:       d.estado ?? \"desconocido\",\n      fuente:               \"whatsapp_upf\",\n      mensaje_original:     d.mensaje_original ?? msgM.msg_body,\n      origen_tipo:          \"whatsapp_channel\",\n      confianza_extraccion: parseFloat(d.confianza ?? 0.5),\n      id_paso:              paso.id,\n      horario_apertura:     d.horario_apertura ?? null,\n      horario_cierre:       d.horario_cierre ?? null,\n      motivo_estado:        d.motivo_estado ?? null,\n      nivel_riesgo_calc:    d.nivel_riesgo ?? null,\n      tipo_vehiculos:       d.tipo_vehiculos ?? [],\n      dias_operacion:       d.dias_operacion ?? [],\n      msg_timestamp:        msgM.msg_timestamp,\n      msg_id_waha:          msgM.msg_id,\n      msg_server_id:        msgM.msg_server_id ?? null\n    }\n  },\n  paso_nombre: paso.nombre_oficial,\n  paso_id:     paso.id\n}}];"
