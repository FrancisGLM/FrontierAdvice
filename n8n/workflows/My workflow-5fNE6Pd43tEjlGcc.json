    {
      "parameters": {
        "jsCode": "const KEYWORDS = [\n  \"complejo\",\"fronterizo\",\"frontera\",\"habilitado\",\"cerrado\",\"abierto\",\n  \"suspendido\",\"precaución\",\"precaucion\",\"habilitada\",\"cerrada\",\n  \"horario\",\"ingreso\",\"salida\",\"vehículo\",\"vehiculo\",\"paso\",\n  \"hrs\",\"hora\",\"a.m.\",\"p.m.\",\n  \"nevada\",\"nieve\",\"tormenta\",\"temporal\",\"viento\",\"lluvia\",\n  \"congelamiento\",\"deslizamiento\",\"alud\",\"ruta\",\n  \"los libertadores\",\"cardenal\",\"pehuenche\",\"pircas negras\",\n  \"jama\",\"colchane\",\"agua negra\",\"vergara\",\"pichachén\",\"pichachen\",\n  \"hua hum\",\"samoré\",\"samore\",\"san francisco\",\"dorotea\",\"casas viejas\",\n  \"san sebastián\",\"san sebastian\",\"bellavista\",\"integración austral\",\n  \"don guillermo\",\"pino hachado\",\"chungará\",\"chungara\",\"chacalluta\",\n  \"ollague\",\"collahuasi\",\"portillo\",\"río blanco\",\n  \"atacama\",\"coquimbo\",\"valparaíso\",\"valparaiso\",\"maule\",\n  \"biobío\",\"biobio\",\"araucanía\",\"araucania\",\"aysén\",\"aysen\",\n  \"magallanes\",\"antofagasta\",\"tarapacá\",\"tarapaca\"\n];\n\nfunction hasKeyword(text) {\n  const lower = text.toLowerCase();\n  return KEYWORDS.some(kw => lower.includes(kw));\n}\n\nconst rawInput = $input.first().json;\nlet msgs = [];\nif (Array.isArray(rawInput)) {\n  msgs = rawInput;\n} else if (Array.isArray(rawInput.messages)) {\n  msgs = rawInput.messages;\n} else {\n  msgs = $input.all().map(i => i.json).filter(m => m.body);\n}\n\nconst config = $(\"Set Config\").first().json;\n\nconst relevantes = msgs.filter(m => m.body && m.body.trim().length > 10 && hasKeyword(m.body));\n\nconsole.log(`Total mensajes: ${msgs.length} | Relevantes: ${relevantes.length}`);\n\nif (relevantes.length === 0) {\n  return [{ json: { sin_relevantes: true, total: msgs.length } }];\n}\n\n// Retornar 1 item por mensaje (ordenados del más antiguo al más nuevo)\nreturn [...relevantes]\n  .sort((a, b) => a.timestamp - b.timestamp)\n  .map(m => ({ json: {\n    msg_id:        m.id,\n    msg_body:      m.body,\n    msg_timestamp: m.timestamp,\n    msg_fecha_iso: new Date(m.timestamp * 1000).toISOString(),\n    msg_row_id:    m._data?.rowId ?? null,\n    msg_server_id: m._data?.serverId ?? null,\n    source_id:     config.source_id,\n    source_name:   config.source_name,\n    captured_at:   config.captured_at,\n    strapi_url:    config.strapi_url,\n    gemini_delay:  config.gemini_delay_ms\n  }}));"
      },
