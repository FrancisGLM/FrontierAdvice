    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json?.output ?? $input.item.json?.text ?? $input.item.json?.content ?? \"\";\nconst msgMeta = $('Filtrar y Splitear Mensajes').item.json;\n\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json\\n?|```/g, \"\").trim();\n  parsed = JSON.parse(cleaned);\n} catch(e) {\n  return [{ json: { parse_error: true, raw, ...msgMeta } }];\n}\n\nconst items = parsed?.items ?? [];\nif (items.length === 0) {\n  return [{ json: { sin_datos: true, ...msgMeta } }];\n}\n\nreturn items.map(item => ({ json: { ...item, ...msgMeta } }));"
      },
