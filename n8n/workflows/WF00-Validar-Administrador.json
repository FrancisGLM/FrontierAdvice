    {
      "parameters": {
        "jsCode": "const esperado = (\"frontier_advice_admin_2026\" || '').toString().trim();\nconst recibido = ($json.admin_key || '').toString().trim();\nconst ok = !!esperado && esperado === recibido;\nreturn [{ json: { ...$json, admin_key_valida: ok } }];"
      },
      "id": "18a9e572-fa5b-46f0-8ad5-0b95216acab6",
      "name": "Validar Admin Secret",
