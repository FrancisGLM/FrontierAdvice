    {
      "parameters": {
        "jsCode": "const u = $json || {};\nconst base = $('Validar Admin Secret').item.json;\nconst rolesPermitidos = ['admin', 'superadmin'];\nconst rol = (u.role?.type || u.role?.name || '').toString().toLowerCase();\nconst jwtValido = !u.error && !!u.id;\nconst autorizado = jwtValido && rolesPermitidos.includes(rol);\n\nreturn [{ json: {\n  autorizado,\n  codigo: autorizado ? 200 : (jwtValido ? 403 : 401),\n  motivo: autorizado ? 'OK' : (jwtValido ? 'Rol sin permisos' : 'JWT invalido o expirado'),\n  usuario: jwtValido ? { id: u.id, email: u.email, username: u.username } : null,\n  rol: rol || null,\n  ip: base.ip,\n  user_agent: base.user_agent\n} }];"
      },
