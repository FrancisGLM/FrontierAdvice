      "parameters": {
        "jsCode": "return [{ json: { autorizado: false, codigo: 400, motivo: 'Parametros invalidos', detalle: $json.errores, usuario: null, rol: null, ip: $json.ip, user_agent: $json.user_agent } }];"
      },
      "id": "ed378f19-1d62-48dc-b8d6-b61063574986",
