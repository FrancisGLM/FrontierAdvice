    {
      "parameters": {
        "jsCode": "const input = $json || {};\nconst jwt = (input.jwt || '').toString().trim();\nconst admin_key = (input.admin_key || '').toString().trim();\nconst ip = (input.ip || '').toString();\nconst user_agent = (input.user_agent || '').toString();\n\nconst errores = [];\nif (!jwt) errores.push('Falta JWT');\nif (!admin_key) errores.push('Falta X-ADMIN-KEY');\n\nreturn [{ json: { jwt, admin_key, ip, user_agent, errores, entrada_valida: errores.length === 0 } }];"
      },
      "id": "f439b3ba-7e3e-42b9-813b-93bde1161e89",
