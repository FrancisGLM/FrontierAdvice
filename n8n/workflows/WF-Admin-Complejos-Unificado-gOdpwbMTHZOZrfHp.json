      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst source = $json.body && Object.keys($json.body).length ? $json.body : $json;\nconst jwt = ((headers.authorization || headers.Authorization || '').replace('Bearer ', '')).trim();\nconst admin_key = (headers['x-admin-key'] || headers['X-ADMIN-KEY'] || '').toString().trim();\nconst ip = (headers['x-forwarded-for'] || '').toString();\nconst user_agent = (headers['user-agent'] || headers['User-Agent'] || '').toString();\nconst accion = (source.accion || '').toString().trim();\nconst paso_documentId = (source.paso_documentId || '').toString().trim();\nconst nombre_oficial = source.nombre_oficial;\nconst latitud = source.latitud;\nconst longitud = source.longitud;\nconst region = source.region;\nconst altitud = source.altitud;\nconst codigo_fuente = source.codigo_fuente;\nconst motivo = source.motivo;\nconst habilitado_para = source.habilitado_para;\nconst errores = [];\nif (!jwt) errores.push('Falta JWT');\nif (!admin_key) errores.push('Falta X-ADMIN-KEY');\nif (!accion || !['actualizar','crear','softdelete'].includes(accion)) errores.push('accion debe ser actualizar, crear o softdelete');\nif (accion !== 'crear' && !paso_documentId) errores.push('Falta paso_documentId');\nif (latitud !== undefined && latitud !== null && latitud !== '' && (isNaN(Number(latitud)) || Number(latitud) < -90 || Number(latitud) > 90)) errores.push('latitud invalida');\nif (longitud !== undefined && longitud !== null && longitud !== '' && (isNaN(Number(longitud)) || Number(longitud) < -180 || Number(longitud) > 180)) errores.push('longitud invalida');\nreturn [{ json: { jwt, admin_key, ip, user_agent, accion, paso_documentId, nombre_oficial, latitud, longitud, region, altitud, codigo_fuente, motivo, habilitado_para, errores, entrada_valida: errores.length === 0 } }];"
