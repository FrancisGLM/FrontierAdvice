      "id": "795b01df-d793-44a5-b607-3e4c11380d58",
      "name": "Respond to Webhook"
    },
    {
      "parameters": {
        "jsCode": "const countryMap = {\n  chile: 'CL',\n  argentina: 'AR',\n  bolivia: 'BO',\n  'peru': 'PE',\n  'perú': 'PE',\n};\n\nconst vehicleMap = {\n  camion: 'hgv',\n  'camión': 'hgv',\n  coche: 'car',\n};\n\nconst truckSubtypeMap = {\n  general: '',\n  autobus: 'bus',\n  'autobús': 'bus',\n  'agrícola': 'agricultural',\n  agricola: 'agricultural',\n  forestal: 'forestry',\n  reparto: 'delivery',\n  mercancía: 'goods',\n  mercancia: 'goods',\n};\n\nfunction normalizeText(value) {\n  return String(value || '').trim().toLowerCase();\n}\n\nfunction detectCountryFromAddress(address) {\n  const text = normalizeText(address);\n\n  if (text.includes('chile')) return 'CL';\n  if (text.includes('argentina')) return 'AR';\n  if (text.includes('bolivia')) return 'BO';\n  if (text.includes('peru') || text.includes('perú')) return 'PE';\n\n  return null;\n}\n\nreturn items.map(item => {\n  const data = item.json;\n\n  const pickupCountry =\n    countryMap[normalizeText(data.pickup_acountryCode)] ||\n    detectCountryFromAddress(data.pickup_address);\n\n  const destinationCountry =\n    countryMap[normalizeText(data.destination_countryCode)] ||\n    detectCountryFromAddress(data.destination_address);\n\n  const vehiculo =\n    vehicleMap[normalizeText(data.vehiculo)] || data.vehiculo;\n\n  const subtipoNormalizado = normalizeText(data.subtipo_camion);\n  const subtipoCamion =\n    subtipoNormalizado === 'general'\n      ? ''\n      : (truckSubtypeMap[subtipoNormalizado] || data.subtipo_camion);\n\n  return {\n    json: {\n      ...data,\n      pickup_acountryCode: pickupCountry,\n      destination_countryCode: destinationCountry,\n      vehiculo,\n      subtipo_camion: subtipoCamion,\n    }\n  };\n});"
      },
