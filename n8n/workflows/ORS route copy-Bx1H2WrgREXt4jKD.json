    {
      "parameters": {
        "jsCode": "// Obtener datos del nodo \"formateo\"\nconst formateoItems = $('formateo').all();\nconst formateoData = formateoItems[0].json;\n\n// Obtener datos del nodo \"Get Pasos_Fronterizos\"\nconst pasosItems = $('Get Pasos_Fronterizos').all();\nconst pasosData = pasosItems[0].json.data;\n\n// Extraer coordenadas de origen y destino\nconst origen = {\n  longitude: parseFloat(formateoData.pickup_longitude),\n  latitude: parseFloat(formateoData.pickup_latitude)\n};\n\nconst destino = {\n  longitude: parseFloat(formateoData.destination_longitude),\n  latitude: parseFloat(formateoData.destination_latitude)\n};\n\n// Extraer solo los campos relevantes de cada paso fronterizo\nconst pasosFronterizos = pasosData.map(paso => ({\n  documentId: paso.documentId,\n  nombre: paso.nombre_oficial,\n  latitud: paso.latitud,\n  longitud: paso.longitud\n}));\n\nreturn [{\n  json: {\n    origen,\n    destino,\n    vehiculo: formateoData.vehiculo,\n    subtipo_camion: formateoData.subtipo_camion,\n    pasos_fronterizos: pasosFronterizos\n  }\n}];"
      },
