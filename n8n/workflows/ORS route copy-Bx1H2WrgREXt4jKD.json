    {
      "parameters": {
        "jsCode": "const itemsIn = $input.all();\n\nif (itemsIn.length < 2) {\n  throw new Error('Se esperaban al menos 2 items: origen y destino');\n}\n\nconst pickup = itemsIn[0].json;\nconst destination = itemsIn[1].json;\n\n// Traer datos del nodo \"Normalización\"\nconst normalizacionItem = $items('Normalización', 0, 0)?.[0]?.json ?? {};\n\nreturn [\n  {\n    json: {\n      pickup_longitude: pickup.p_longitude ?? null,\n      pickup_latitude: pickup.p_latitude ?? null,\n      destination_longitude: destination.d_longitude ?? null,\n      destination_latitude: destination.d_latitude ?? null,\n      vehiculo: normalizacionItem.vehiculo ?? null,\n      subtipo_camion: normalizacionItem.subtipo_camion ?? null,\n    }\n  }\n];"
      },
