    {
      "parameters": {
        "jsCode": "// ─── Entrada ───────────────────────────────────────────────────────────────\nconst item = $input.all()[0].json;\n\nconst originLat  = parseFloat(item.pickup_latitude);\nconst originLng  = parseFloat(item.pickup_longitude);\nconst destLat    = parseFloat(item.destination_latitude);\nconst destLng    = parseFloat(item.destination_longitude);\n\n// ─── Pasos fronterizos (hardcoded desde el nodo anterior o puedes inyectarlos) ──\nconst pasos = $input.all()[1]?.json?.data ?? item.pasos_fronterizos;\n\n// ─── Función Haversine ──────────────────────────────────────────────────────\nfunction haversine(lat1, lng1, lat2, lng2) {\n  const R = 6371; // km\n  const toRad = x => x * Math.PI / 180;\n  const dLat = toRad(lat2 - lat1);\n  const dLng = toRad(lng2 - lng1);\n  const a =\n    Math.sin(dLat / 2) ** 2 +\n    Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *\n    Math.sin(dLng / 2) ** 2;\n  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n}\n\n// ─── Distancia punto a segmento (A→C) ──────────────────────────────────────\n// Proyecta B sobre el segmento y devuelve la distancia perpendicular\nfunction distanciaAlSegmento(bLat, bLng, aLat, aLng, cLat, cLng) {\n  // Convertir a \"pseudocoord\" para la proyección\n  const dx = cLng - aLng;\n  const dy = cLat - aLat;\n  const lenSq = dx * dx + dy * dy;\n\n  let t = 0;\n  if (lenSq > 0) {\n    t = ((bLng - aLng) * dx + (bLat - aLat) * dy) / lenSq;\n    t = Math.max(0, Math.min(1, t)); // clampar entre 0 y 1\n  }\n\n  const projLat = aLat + t * dy;\n  const projLng = aLng + t * dx;\n\n  return haversine(bLat, bLng, projLat, projLng);\n}\n\n// ─── Calcular puntuación de cada paso ──────────────────────────────────────\n// Score = distancia(A→B) + distancia(B→C)\n// Así elegimos el que minimiza el desvío total del viaje\nconst pasosConScore = pasos.map(paso => {\n  const distAB = haversine(originLat, originLng, paso.latitud, paso.longitud);\n  const distBC = haversine(paso.latitud, paso.longitud, destLat, destLng);\n  const totalRuta = distAB + distBC;\n  const desvioLineal = distanciaAlSegmento(\n    paso.latitud, paso.longitud,\n    originLat, originLng,\n    destLat, destLng\n  );\n\n  return {\n    ...paso,\n    distancia_origen_km: Math.round(distAB),\n    distancia_destino_km: Math.round(distBC),\n    total_ruta_km: Math.round(totalRuta),\n    desvio_lineal_km: Math.round(desvioLineal)\n  };\n});\n\n// Ordenar por ruta total (A→B + B→C)\npasosConScore.sort((a, b) => a.total_ruta_km - b.total_ruta_km);\n\nconst mejorPaso = pasosConScore[0];\nconst top3Pasos = pasosConScore.slice(0, 3);\n\n// ─── Output ─────────────────────────────────────────────────────────────────\nreturn [{\n  json: {\n    origen: { lat: originLat, lng: originLng },\n    destino: { lat: destLat, lng: destLng },\n    paso_seleccionado: {\n      id: mejorPaso.id,\n      nombre: mejorPaso.nombre_oficial,\n      latitud: mejorPaso.latitud,\n      longitud: mejorPaso.longitud,\n      distancia_origen_km: mejorPaso.distancia_origen_km,\n      distancia_destino_km: mejorPaso.distancia_destino_km,\n      total_ruta_km: mejorPaso.total_ruta_km\n    },\n    top3_alternativas: top3Pasos.map(p => ({\n      nombre: p.nombre_oficial,\n      total_ruta_km: p.total_ruta_km\n    })),\n    // Pasar coordenadas para el siguiente nodo ORS\n    ors_waypoints: [\n      [originLng, originLat],\n      [mejorPaso.longitud, mejorPaso.latitud],\n      [destLng, destLat]\n    ]\n  }\n}];"
      },
