      {
        "parameters": {
          "jsCode": "// Input esperado en este nodo:\n// [\n//   { p_longitude, p_latitude, ... },\n//   { d_longitude, d_latitude, ... }\n// ]\n\nconst normalizacion = $('Normalización').first().json;\n\nconst origenItem = items.find(item =>\n  item.json.p_longitude != null && item.json.p_latitude != null\n);\n\nconst destinoItem = items.find(item =>\n  item.json.d_longitude != null && item.json.d_latitude != null\n);\n\nif (!origenItem) {\n  throw new Error('No se encontró el origen (p_longitude / p_latitude)');\n}\n\nif (!destinoItem) {\n  throw new Error('No se encontró el destino (d_longitude / d_latitude)');\n}\n\nreturn [\n  {\n    json: {\n      origen: {\n        longitude: Number(origenItem.json.p_longitude),\n        latitude: Number(origenItem.json.p_latitude),\n      },\n      destino: {\n        longitude: Number(destinoItem.json.d_longitude),\n        latitude: Number(destinoItem.json.d_latitude),\n      },\n      vehiculo: normalizacion.vehiculo,\n      subtipo_camion: normalizacion.subtipo_camion,\n    }\n  }\n];"
        },
        "type": "n8n-nodes-base.code",
