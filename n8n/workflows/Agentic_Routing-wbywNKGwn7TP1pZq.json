          "jsCode": "const textoAgente = $input.all()[0].json.text || $input.all()[0].json.output;\n\n// Limpiamos los backticks de markdown por si el LLM los llega a poner\nlet textoLimpio = textoAgente.replace(/^```json\\n/, '').replace(/\\n```$/, '');\n\nlet datos = JSON.parse(textoLimpio);\n\nif (datos.output) {\n    datos = datos.output;\n}\n\nreturn [{ json: datos }];\n"
