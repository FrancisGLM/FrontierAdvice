      },
      {
        "parameters": {
          "jsCode": "const pasoResp = $json.data || [];\nconst paso = pasoResp[0];\nconst original = $(\"Parse Model Output\").item.json;\nreturn [{json: {data: {fecha_reporte: original.fecha_reporte, estado_general: original.estado_general, fuente: original.fuente, mensaje_original: original.mensaje_original, confianza_extraccion: parseFloat(original.confianza_extraccion), origen_tipo: original.origen_tipo, id_paso: paso.id}}}];"
        },
