        "name": "Obtener Mensajes WAHA"
      },
      {
        "parameters": {
          "jsCode": "const wahaMessages = Array.isArray($json) ? $json : ($json.messages || []);\nconst metadata = $(\"Set Source Metadata\").first().json;\nconst textos = wahaMessages.filter(m => m.body && m.body.trim().length > 5).map(m => m.body.trim());\nif (textos.length === 0) throw new Error(\"WAHA no retornó mensajes con contenido útil.\");\nreturn [{json: {source_id: metadata.source_id, source_type: metadata.source_type, source_name: metadata.source_name, channel_label: metadata.channel_label, captured_at: metadata.captured_at, messages: textos}}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          272,
          -528
        ],
        "id": "33565a00-baf9-4ffb-9671-945fca32dc23",
        "name": "Transformar Mensajes WAHA"
      },
      {
        "parameters": {
          "promptType": "define",
          "text": "Eres un normalizador de mensajes oficiales sobre pasos fronterizos de Chile para FrontierAdvice.\n\nTu tarea es convertir mensajes provenientes de WhatsApp en JSON estricto.\n\nDebes devolver SOLO JSON válido, sin markdown, sin explicación y sin texto adicional.\n\nReglas:\n- Detecta el paso fronterizo mencionado si existe.\n- Si un mensaje contiene múltiples pasos (ej: una región entera), genera un item por cada paso.\n- Clasifica \"estado_general\" como uno de: \"abierto\", \"cerrado\", \"abierto_con_precaucion\", \"suspendido\", \"desconocido\".\n- Conserva el mensaje original completo en \"mensaje_original\".\n- \"fuente\" debe ser siempre \"whatsapp_upf\".\n- \"origen_tipo\" debe ser siempre \"whatsapp_channel\".\n- \"confianza_extraccion\" debe ser un número decimal entre 0 y 1.\n- \"fecha_reporte\" usa formato ISO 8601. Si el mensaje incluye fecha (ej: \"05/06/26\"), conviértela. Si no, usa la fecha de ejecución.\n- \"codigo_fuente\" debe ser el nombre simplificado del complejo en minúsculas con guiones (ej: \"los-libertadores\", \"pino-hachado\", \"cardenal-samore\"). Si no puede identificarse, usa null.\n- Omite mensajes que no aporten estado operativo útil.\n\nFormato exacto de salida:\n{\n  \"items\": [\n    {\n      \"codigo_fuente\": null,\n      \"fecha_reporte\": \"{{$json.captured_at}}\",\n      \"estado_general\": \"\",\n      \"fuente\": \"whatsapp_upf\",\n      \"mensaje_original\": \"\",\n      \"confianza_extraccion\": 0.0,\n      \"origen_tipo\": \"whatsapp_channel\"\n    }\n  ]\n}\n\nMensajes a normalizar:\n{{ JSON.stringify($json.messages) }}",
          "batching": {}
        },
        "type": "@n8n/n8n-nodes-langchain.chainLlm",
        "typeVersion": 1.9,
        "position": [
          464,
          -528
        ],
        "id": "69583688-e4db-4b7b-9ec2-0447f349c429",
        "name": "Normalize Whatsapp Messages"
      },
      {
        "parameters": {
          "modelName": "models/gemini-2.5-flash",
          "options": {
            "maxOutputTokens": 8192
          }
        },
        "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
        "typeVersion": 1.1,
        "position": [
          464,
          -320
        ],
        "id": "558b1fee-8f55-4d74-ac05-0765aa312751",
        "name": "Google Gemini Chat Model",
        "credentials": {
          "googlePalmApi": {
            "id": "gkGbag9Eoxr0uPjN",
            "name": "Google Gemini(PaLM) Api account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const raw = $json.text ?? $json.output ?? $json.response ?? $json.result ?? $json.message ?? $json.content ?? $json;\nlet parsed;\nlet cleaned = raw;\nif (typeof cleaned === \"string\") {\n  cleaned = cleaned.replace(/```json\\s*/g, \"\").replace(/```/g, \"\").trim();\n  const start = cleaned.indexOf(\"{\");\n  const end = cleaned.lastIndexOf(\"}\");\n  if (start !== -1 && end !== -1) cleaned = cleaned.slice(start, end + 1);\n  parsed = JSON.parse(cleaned);\n} else { parsed = cleaned; }\nif (!parsed || !parsed.items || !Array.isArray(parsed.items)) throw new Error(\"No se encontró items[] en la salida del modelo. Output: \" + JSON.stringify($json).slice(0, 500));\nconst capturedAt = $(\"Set Source Metadata\").first().json.captured_at;\nreturn parsed.items.map(item => ({json: {codigo_fuente: item.codigo_fuente || null, fecha_reporte: item.fecha_reporte || capturedAt, estado_general: item.estado_general || \"desconocido\", fuente: item.fuente || \"whatsapp_upf\", mensaje_original: item.mensaje_original || null, confianza_extraccion: parseFloat(item.confianza_extraccion) || 0.5, origen_tipo: item.origen_tipo || \"whatsapp_channel\"}}));"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          768,
          -528
        ],
        "id": "d6da13cc-9a94-4fb5-98b9-0c8b70d96dad",
        "name": "Parse Model Output"
      },
