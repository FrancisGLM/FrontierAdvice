    {
      "parameters": {
        "jsCode": "const raw = $json.text ?? $json.output ?? $json.response ?? $json.result ?? $json.message ?? $json.content ?? $json;\nlet parsed;\nlet cleaned = raw;\nif (typeof cleaned === \"string\") {\n  cleaned = cleaned.replace(/```json\\s*/g, \"\").replace(/```/g, \"\").trim();\n  const start = cleaned.indexOf(\"{\");\n  const end = cleaned.lastIndexOf(\"}\");\n  if (start !== -1 && end !== -1) cleaned = cleaned.slice(start, end + 1);\n  parsed = JSON.parse(cleaned);\n} else { parsed = cleaned; }\nif (!parsed || !parsed.items || !Array.isArray(parsed.items)) throw new Error(\"No se encontró items[] en la salida del modelo. Output: \" + JSON.stringify($json).slice(0, 500));\nconst capturedAt = $(\"Set Source Metadata\").first().json.captured_at;\nreturn parsed.items.map(item => ({json: {codigo_fuente: item.codigo_fuente || null, fecha_reporte: item.fecha_reporte || capturedAt, estado_general: item.estado_general || \"desconocido\", fuente: item.fuente || \"whatsapp_upf\", mensaje_original: item.mensaje_original || null, confianza_extraccion: parseFloat(item.confianza_extraccion) || 0.5, origen_tipo: item.origen_tipo || \"whatsapp_channel\"}}));"
      },
