{
  "kind": "collectionType",
  "collectionName": "mensaje_wahas",
  "info": {
    "singularName": "mensaje-waha",
    "pluralName": "mensaje-wahas",
    "displayName": "MensajeWAHA"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
